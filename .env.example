# Скопируйте в .env и заполните перед деплоем (или задайте как переменные окружения хостинга)

# Секрет для подписи сессионных cookie. Обязательно задайте случайное значение в проде:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Доступ к служебной админ-панели на /admin (управление списком вопросов игры).
# ОБЯЗАТЕЛЬНЫ — сервер не запустится без них, дефолтного пароля в коде нет.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Ключ OpenRouter (openrouter.ai) для генерации вопросов через AI в админке —
# доступ к открытым моделям (DeepSeek, Llama, Qwen и др.) без региональных
# ограничений. Без него админка работает (просмотр/добавление/удаление вручную),
# но кнопка «Сгенерировать через AI» будет возвращать ошибку.
OPENROUTER_API_KEY=

# Необязательно: какую модель на OpenRouter использовать для генерации.
# По умолчанию "openrouter/free" — авто-роутер, который сам выбирает
# бесплатную модель из доступных на данный момент (список бесплатных моделей
# часто меняется, поэтому проще довериться авто-выбору, чем прописывать
# конкретную :free модель, которая может пропасть из линейки).
# Можно указать и конкретную модель — список: openrouter.ai/models
OPENROUTER_MODEL=
