# Скопируйте в .env и заполните перед деплоем (или задайте как переменные окружения хостинга)

# Секрет для подписи сессионных cookie. Обязательно задайте случайное значение в проде:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Доступ к служебной админ-панели на /admin (управление списком вопросов игры).
# ОБЯЗАТЕЛЬНЫ — сервер не запустится без них, дефолтного пароля в коде нет.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Ключ Anthropic API для генерации вопросов через AI в админке (console.anthropic.com).
# Без него админка работает (просмотр/добавление/удаление вручную), но кнопка
# «Сгенерировать через AI» будет возвращать ошибку.
ANTHROPIC_API_KEY=
